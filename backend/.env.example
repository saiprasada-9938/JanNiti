# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Gemini API key used for text and photo analysis (ai_service.py / photo_service.py).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Admin login for the admin dashboard.
# Plain username; you can change it freely.
ADMIN_USERNAME=admin

# IMPORTANT: ADMIN_PASSWORD must be a bcrypt HASH, not plaintext.
# Generate one with:
#   import bcrypt; print(bcrypt.hashpw(b"yourpassword", bcrypt.gensalt()).decode())
ADMIN_PASSWORD=$2b$12$your_bcrypt_hash_here

# Secret used to sign admin JWT tokens (any long random string).
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_random_jwt_secret_here